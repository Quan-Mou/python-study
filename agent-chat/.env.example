# 复制为 .env（放在 agent-chat 目录，或项目根目录）后按需填写

# ---- 业务数据库（MySQL，异步驱动 aiomysql）----
# 先建库：CREATE DATABASE agent_chat CHARACTER SET utf8mb4;
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/agent_chat?charset=utf8mb4

# ---- JWT ----
SECRET_KEY=请换成一段足够长的随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 大模型（公司网关，OpenAI 兼容协议）----
COMPANY_API_KEY=你的key
COMPANY_BASE_URL=https://你的网关地址
LLM_MODEL=qwen3.7-plus
